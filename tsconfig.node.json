{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/shared/**/*",
    "src/domain/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "tests/unit/shortcuts.test.ts",
    "tests/unit/nativeMenu.test.ts"
  ]
}
