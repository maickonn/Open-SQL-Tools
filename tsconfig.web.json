{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/domain/**/*",
    "src/application/import/**/*",
    "src/preload/api.d.ts",
    "src/application/copy/**/*",
    "tests/unit/shortcuts.test.ts"
  ]
}
