{
  "name": "open-sql-tools",
  "productName": "Open SQL Tools",
  "version": "0.3.0",
  "description": "Modern desktop SQL client for Firebird, MySQL, MariaDB, PostgreSQL and SQLite with an agentic AI chat.",
  "main": "./out/main/index.js",
  "author": "Maickonn Richard",
  "license": "MIT",
  "homepage": "https://github.com/maickonn/Open-SQL-Tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maickonn/Open-SQL-Tools.git"
  },
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder",
    "test:db": "node scripts/test-db.mjs",
    "db:up": "docker compose -f docker/compose.yml up -d --wait",
    "db:stop": "docker compose -f docker/compose.yml stop",
    "postinstall": "node node_modules/electron/install.js",
    "test:e2e:db": "node scripts/test-e2e-db.mjs",
    "demo": "npm run build && node scripts/demo/record.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "mysql2": "3.24.6",
    "node-firebird": "2.18.2",
    "openai": "7.38.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@glideapps/glide-data-grid": "6.0.3",
    "@noble/curves": "2.4.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.21",
    "@types/node": "24.9.0",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "i18next": "26.5.2",
    "lodash": "4.18.1",
    "lucide-react": "1.59.0",
    "marked": "4.3.0",
    "monaco-editor": "0.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.6",
    "react-responsive-carousel": "3.2.23",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "sql-formatter": "15.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "overrides": {
    "@glideapps/glide-data-grid": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
